function loadRapports(c){c.innerHTML='<div class="fade-in space-y-6"><h3 class="text-xl font-bold">Rapports et Exports</h3><div class="row-grid"><div class="panel text-center py-8"><div class="text-4xl mb-3">📊</div><h3>Rapport Ventes</h3><p class="text-muted text-sm mb-4">Exportez la liste complete des ventes</p><a href="/api/rapports/ventes?format=csv" onclick="this.href=this.href+&#39;&token=&#39;+localStorage.getItem(&#39;sourougnon_token&#39;)" target="_blank" class="inline-block bg-accent text-white px-6 py-3 rounded-xl text-sm font-semibold hover:bg-blue-700">Export CSV Ventes</a></div><div class="panel text-center py-8"><div class="text-4xl mb-3">💳</div><h3>Rapport Paiements</h3><p class="text-muted text-sm mb-4">Exportez l historique des encaissements</p><a href="/api/rapports/recouvrements?format=csv" onclick="this.href=this.href+&#39;&token=&#39;+localStorage.getItem(&#39;sourougnon_token&#39;)" target="_blank" class="inline-block bg-accent text-white px-6 py-3 rounded-xl text-sm font-semibold hover:bg-blue-700">Export CSV Paiements</a></div><div class="panel text-center py-8"><div class="text-4xl mb-3">📋</div><h3>Resume Mensuel</h3><p class="text-muted text-sm mb-4">Synthese des performances du mois</p><a href="/api/rapports/resume" onclick="event.preventDefault();loadResume(this)" class="inline-block bg-accent text-white px-6 py-3 rounded-xl text-sm font-semibold hover:bg-blue-700">Voir le resume</a></div></div><div id="resume-content"></div></div>';}
function loadResume(b){b.textContent='Chargement...';apiFetch('/rapports/resume').then(function(r){function f(v){return new Intl.NumberFormat('fr-FR',{style:'currency',currency:'XOF',maximumFractionDigits:0}).format(v);}var c=document.getElementById('resume-content');c.innerHTML='<div class="fade-in space-y-6 mt-6"><div class="panel"><h3>Aujourd hui</h3><div class="kpi-grid"><div class="kpi-card"><div class="kpi-label">Encaissements</div><div class="kpi-value">'+f(r.aujourdhui.encaissements)+'</div></div><div class="kpi-card"><div class="kpi-label">Nb Paiements</div><div class="kpi-value">'+r.aujourdhui.nb_paiements+'</div></div><div class="kpi-card"><div class="kpi-label">Ventes</div><div class="kpi-value">'+r.aujourdhui.ventes_jour+'</div></div><div class="kpi-card"><div class="kpi-label">CA Jour</div><div class="kpi-value">'+f(r.aujourdhui.ca_jour)+'</div></div></div></div><div class="panel"><h3>Ce mois</h3><div class="kpi-grid"><div class="kpi-card"><div class="kpi-label">Encaissements</div><div class="kpi-value">'+f(r.mois.encaissements)+'</div></div><div class="kpi-card"><div class="kpi-label">Nb Paiements</div><div class="kpi-value">'+r.mois.nb_paiements+'</div></div><div class="kpi-card"><div class="kpi-label">Ventes</div><div class="kpi-value">'+r.mois.ventes_mois+'</div></div><div class="kpi-card"><div class="kpi-label">Creances</div><div class="kpi-value">'+f(r.mois.creances)+'</div></div></div></div><div class="panel"><h3>Top Agents du Mois</h3><div class="table-wrapper"><table><thead><tr><th>Agent</th><th class="text-right">Total Encaisse</th></tr></thead><tbody>'+r.top_agents_mois.map(function(a){return '<tr><td class="font-medium">'+(a.agent?a.agent.nom:'--')+' '+(a.agent?a.agent.prenom:'')+'</td><td class="text-right font-semibold">'+f(a.total)+'</td></tr>';}).join('')+'</tbody></table></div></div></div>';b.textContent='Rafraichir le resume';});}
